"+" -> PLUS;
"-" -> MINUS;
"*" -> TIMES;
"/" -> SLASH;
"("  -> LPAREN;
")" -> RPAREN;
";" -> SEMICOLON;
","  -> COMMA;
"."  -> PERIOD;
":=" -> BECOMES;
"="  -> EQL;
"<>" -> NEQ;
"<"  -> LSS;
">"  -> GTR;
"<=" -> LEQ;
">=" -> GEQ;
"begin"-> BEGINSYM;
"call" -> CALLSYM;
"const" -> CONSTSYM;
"do" -> DOSYM;
"end" -> ENDSYM;
"if" -> IFSYM;
"odd" -> ODDSYM;
"procedure" -> PROCSYM;
"then" -> THENSYM;
"var" -> VARSYM;
"while" -> WHILESYM;

Regex digit         [0-9];
Regex letter        [a-zA-Z];

{letter}[{letter}{digit}]* -> {
                        Token tok = IDENT.setStringContent(var.getLexeme());
                        return tok;
 };

{digit}+ -> {
                        var.attribute.num = Integer.parseInt(var.getLexeme());
                        return NUMBER;
};

/*Skipps white spaces*/ 
"\t";
"\n";
"\r";
" ";

default -> REJECT;
