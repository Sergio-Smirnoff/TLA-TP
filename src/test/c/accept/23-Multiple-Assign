"b" -> {
    Boolean bool1 = true;
    Boolean bool2 = false;
    
    bool1 |= bool2; // bool1 = bool1 | bool2
    System.out.println("bool1 after |=: " + bool1); // Output: true
    
    bool1 ^= bool2; // bool1 = bool1 ^ bool2
    System.out.println("bool1 after ^=: " + bool1); // Output: true
    
    bool1 &= false; // bool1 = bool1 & false
    System.out.println("bool1 after &=: " + bool1); // Output: false
};
