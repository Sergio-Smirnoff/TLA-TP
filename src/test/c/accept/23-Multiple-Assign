"d" -> {
    Integer c = 8; // Binary: 1000
    c <<= 2; // c = c << 2 (Left shift by 2)
    System.out.println("c after <<=: " + c); // Output: 32 (Binary: 100000)
    
    c >>= 1; // c = c >> 1 (Right shift by 1)
    System.out.println("c after >>=: " + c); // Output: 16 (Binary: 10000)
    
    c >>>= 2; // c = c >>> 2 (Unsigned right shift by 2)
    System.out.println("c after >>>=: " + c); // Output: 4 (Binary: 100)
};

"c" -> {
    Integer d = 5;  // Binary: 0101
    d ^= 3; // d = d ^ 3 (Bitwise XOR with 3 -> Binary: 0011)
    System.out.println("d: " + d); // Output: 6 (Binary: 0110)
};

