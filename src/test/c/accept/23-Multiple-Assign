"g" -> {
    Boolean flag1 = true;
    Boolean flag2 = false;
    
    flag1 &= flag2; // flag1 = flag1 & flag2 (logical AND)
    System.out.println("flag1 after &=: " + flag1); // Output: false
    
    flag2 |= true; // flag2 = flag2 | true (logical OR)
    System.out.println("flag2 after |=: " + flag2); // Output: true
};

