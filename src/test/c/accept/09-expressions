"+" -> PLUS;
"-" -> MINUS;
"*" -> TIMES;
"/" -> SLASH;
"("  -> LPAREN;
")" -> RPAREN;
"="  -> EQL;
"<>" -> NEQ;
"<"  -> LSS;
">"  -> GTR;
"<=" -> LEQ;
">=" -> GEQ;

Regex digit         [0-9];

{digit}+ -> {
                       var.attribute.num = Integer.parseInt(var.getLexeme());
                       return NUMBER;
};

/*Skipps white spaces*/ 
"\t";
"\n";
"\r";

default -> { return REJECT; };
